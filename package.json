{
  "name": "anatomy",
  "version": "0.0.1",
  "type": "module",
  "description": "Anatomy: extract transferable engineering decisions from a codebase",
  "bin": {
    "ana": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-sidecar.mjs",
    "test": "vitest run",
    "eval": "node --experimental-strip-types eval/run.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "verify": "bash scripts/verify.sh",
    "eval:recall": "node --experimental-strip-types eval/recall-lite.ts"
  },
  "dependencies": {
    "tokenx": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
