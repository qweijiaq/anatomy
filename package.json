{
  "name": "anatomy",
  "version": "0.1.0",
  "type": "module",
  "description": "Dissect a repository into evidence-backed design notes: every claim cites file:line and is checked against the bytes on disk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qweijiaq/anatomy.git"
  },
  "homepage": "https://github.com/qweijiaq/anatomy#readme",
  "bugs": "https://github.com/qweijiaq/anatomy/issues",
  "bin": {
    "ana": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-sidecar.mjs",
    "test": "vitest run",
    "eval": "node --experimental-strip-types eval/run.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.desktop.json",
    "verify": "bash scripts/verify.sh",
    "eval:recall": "node --experimental-strip-types eval/recall-lite.ts",
    "eval:quality": "node --experimental-strip-types eval/sample-points.ts",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "npm run build:electron && npm run build:renderer",
    "build:bundle": "node scripts/build-app-bundle.mjs",
    "clean": "rm -rf dist dist-renderer dist-electron out",
    "dev:desktop": "ANA_DEV_SERVER=http://127.0.0.1:5199 node run-electron.mjs",
    "start:desktop": "npm run build:desktop && node run-electron.mjs",
    "dev:renderer": "vite --config vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tokenx": "^0.4.1",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "main": "dist-electron/main.cjs"
}
