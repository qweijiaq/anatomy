.DS_Store
node_modules/
dist/
ANA/
.ana/runs/*/tree/
# The execution record is tracked: the plan and the ledger are the two files the
# work is judged from, and an untracked ledger does not exist in a clean checkout.
# Review diffs stay scratch — they are regenerable from git and can be megabytes.
.superpowers/**/review-*.diff
.npm-cache/

# tests/fixtures/repo-small is a fixture repository: its generated/vendored trees are
# test input, so the rules above must not swallow them. Files that the fixture's own
# .gitignore matches are force-added once; tracked files are immune to ignore rules.
!tests/fixtures/repo-small/dist/
!tests/fixtures/repo-small/node_modules/
.ana/runs/
# `ana inspect-app` output: a survey plus the untouched REA evidence file, which runs
# to hundreds of megabytes for an application with a large bundle.
.ana/apps/

# Generated by npm run eval:quality — the reports are the artefact, the runs are not.
eval/quality-sample/.runs/
# Same for eval:recall: 29 scan runs per invocation, none of them a report.
eval/recall-sample/

# Desktop app build output
dist-renderer/
dist-electron/
# The assembled .app bundle: a 234 MB copy of the Electron runtime, rebuilt by
# `npm run build:bundle`. Nothing in it is written by hand.
out/
