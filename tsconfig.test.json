{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "tests", "vitest.config.ts"],
  // Fixtures are raw bytes on purpose (lone CR, invalid UTF-8, BOM) and are never
  // imported by tests, only read by path. Typechecking them yields a bogus
  // TS1490 "File appears to be binary" plus parser noise instead of signal.
  "exclude": ["tests/fixtures"]
}
